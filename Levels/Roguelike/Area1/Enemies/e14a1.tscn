[node name="DialogueInteraction" parent="NPCGnomeHunter/QuestActivatedSwitch3" instance=ExtResource("17_m8ux2")]

[node name="DialogueText" type="Node" parent="NPCGnomeHunter/QuestActivatedSwitch3/DialogueInteraction"]
script = ExtResource("18_tx64q")
text = "You did it! You got the fabled dragon treasure!!!

I've always wanted that treasure..."
npcInfo = ExtResource("14_vqimk")
metadata/_custom_type_script = "uid://dibm0sw4mb3u8"

[node name="DialogueText2" type="Node" parent="NPCGnomeHunter/QuestActivatedSwitch3/DialogueInteraction"]
script = ExtResource("18_tx64q")
text = "If you gave it to me for my tribe, I'd give you all the money I had..."
npcInfo = ExtResource("14_vqimk")
metadata/_custom_type_script = "uid://dibm0sw4mb3u8"

[node name="DialogueChoice" type="Node" parent="NPCGnomeHunter/QuestActivatedSwitch3/DialogueInteraction"]
script = ExtResource("19_t2x6m")
npcInfo = ExtResource("14_vqimk")
metadata/_custom_type_script = "uid://doesf52yw1ogg"

[node name="DialogueBranch" type="Node" parent="NPCGnomeHunter/QuestActivatedSwitch3/DialogueInteraction/DialogueChoice"]
script = ExtResource("20_6di5a")
text = "Fine, you can have the treasure."
npcInfo = ExtResource("14_vqimk")
metadata/_custom_type_script = "uid://cdk6dpee5kak6"

[node name="DialogueText" type="Node" parent="NPCGnomeHunter/QuestActivatedSwitch3/DialogueInteraction/DialogueChoice/DialogueBranch"]
script = ExtResource("18_tx64q")
text = "Yippeeeeee!!!

Thank you so much!!!
Here's my wallet!"
npcInfo = ExtResource("14_vqimk")
metadata/_custom_type_script = "uid://dibm0sw4mb3u8"

