[node name="DialogueInteraction" parent="NPCGnomeHunter/QuestActivatedSwitch" instance=ExtResource("17_m8ux2")]

[node name="DialogueText" type="Node" parent="NPCGnomeHunter/QuestActivatedSwitch/DialogueInteraction"]
script = ExtResource("18_tx64q")
text = "There it is up there! The emerald cave dragon!
"
npcInfo = ExtResource("14_vqimk")
metadata/_custom_type_script = "uid://dibm0sw4mb3u8"

[node name="DialogueText2" type="Node" parent="NPCGnomeHunter/QuestActivatedSwitch/DialogueInteraction"]
script = ExtResource("18_tx64q")
text = "I was sent by the Gnomes to kill it for the treasure....

But I'm too scared....
"
npcInfo = ExtResource("14_vqimk")
metadata/_custom_type_script = "uid://dibm0sw4mb3u8"

[node name="DialogueChoice" type="Node" parent="NPCGnomeHunter/QuestActivatedSwitch/DialogueInteraction"]
script = ExtResource("19_t2x6m")
npcInfo = ExtResource("14_vqimk")
metadata/_custom_type_script = "uid://doesf52yw1ogg"

[node name="DialogueBranch" type="Node" parent="NPCGnomeHunter/QuestActivatedSwitch/DialogueInteraction/DialogueChoice"]
script = ExtResource("20_6di5a")
text = "I'll help you!"
npcInfo = ExtResource("14_vqimk")
metadata/_custom_type_script = "uid://cdk6dpee5kak6"

[node name="DialogueText" type="Node" parent="NPCGnomeHunter/QuestActivatedSwitch/DialogueInteraction/DialogueChoice/DialogueBranch"]
script = ExtResource("18_tx64q")
text = "Thank you!! Watch out for her sharp claws, they can slice your arms and legs off with ease!
Come back when you kill it!"
npcInfo = ExtResource("14_vqimk")
metadata/_custom_type_script = "uid://dibm0sw4mb3u8"

